    <artifactId>inference-external-core</artifactId>
    <name>inference-external-core</name>
    <description>
        Shared library for the external variants (X-Sync and X-Async).
        Holds the HuggingFace Inference API wire-format DTOs, the
        label-to-Sentiment mapping, and the HTTP/transport-to-FailureMode
        mapping policy specific to the external vendor.
    </description>
    <dependencies>
        <dependency>
            <groupId>com.thesis</groupId>
            <artifactId>inference-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>